import cv2
import mediapipe as mp
import serial
import time
import math

# ----------- SERIAL SETUP -----------
ser = serial.Serial('COM16', 9600)   # Your correct port
time.sleep(0.2)

# ----------- MEDIAPIPE SETUP --------
mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils
hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.7)

cap = cv2.VideoCapture(0)

def angle(a, b, c):
    ax, ay = a.x, a.y
    bx, by = b.x, b.y
    cx, cy = c.x, c.y
    ab = math.hypot(ax - bx, ay - by)
    cb = math.hypot(cx - bx, cy - by)
    ac = math.hypot(ax - cx, ay - cy)
    if ab * cb == 0:
        return 0
    return math.degrees(math.acos((ab*ab + cb*cb - ac*ac) / (2 * ab * cb)))

def classify(lm):
    tips = [8, 12, 16, 20]
    pips = [6, 10, 14, 18]
    fingers = [1 if lm[tips[i]].y < lm[pips[i]].y else 0 for i in range(4)]

    thumb_tip = lm[4]
    thumb_ip  = lm[3]
    thumb_mcp = lm[2]
    thumb_ang = angle(thumb_tip, thumb_ip, thumb_mcp)
    index_tip = lm[8]

    # ✊ FIST
    if fingers == [0,0,0,0]:
        return "FIST"

    # ✌️ PEACE
    if fingers == [1,1,0,0]:
        return "PEACE"

    # 👍 LIKE
    if thumb_ang < 25 and fingers == [0,0,0,0]:
        return "LIKE"

    # 🤟 YOYO
    if fingers == [1,0,0,1] and thumb_tip.y < thumb_ip.y:
        return "YOYO"

    # 👌 WOW (thumb touching index)
    ok_touch = abs(lm[8].x - lm[4].x) < 0.03 and abs(lm[8].y - lm[4].y) < 0.03
    if ok_touch and fingers == [0,1,1,1]:
        return "WOW"

    # 🫲 PALM
    if fingers == [1,1,1,1]:
        return "PALM"

    # 🤫 SHHH (index up, rest down)
    if fingers == [1,0,0,0]:
        return "SHHHHHHHHH"

    # 🖕 MIDDLE FINGER (only middle open)
    if fingers == [0,1,0,0]:
        return "CHAL CHAL CHAL"

    return "UNKNOWN"

stable_gesture = ""
count = 0

while True:
    
    ret, frame = cap.read()
    imgRGB = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    res = hands.process(imgRGB)

    gesture = "No Hand"

    if res.multi_hand_landmarks:
        for handLms in res.multi_hand_landmarks:
            mp_draw.draw_landmarks(frame, handLms, mp_hands.HAND_CONNECTIONS)
            gesture = classify(handLms.landmark)

    # ---- STABILITY FILTER ----
    if gesture == stable_gesture:
        count += 1
    else:
        count = 0

    if count == 5:      # must stay same for 5 frames
        ser.write((gesture + "\n").encode())
    
    if count == 5:
        print("Sent:", gesture)

    stable_gesture = gesture

    cv2.putText(frame, f"Gesture: {gesture}", (10,50),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (0,255,0), 3)

    cv2.imshow("Gesture Detection", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break


cap.release()
cv2.destroyAllWindows()
